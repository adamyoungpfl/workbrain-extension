{
  "$comment": "Single source of truth. `npm run tokens` generates src/panel/tokens.css from this. Never hand-edit the CSS. Contrast ratios are measured against --canvas unless noted.",
  "color": {
    "canvas":   { "value": "#FFFFFF" },
    "surface":  { "value": "#F6F7F9" },
    "sunken":   { "value": "#EDEFF3" },
    "ink":      { "value": "#15181D", "contrast": 17.79, "level": "AAA" },
    "ink-2":    { "value": "#525A67", "contrast": 6.96,  "level": "AA" },
    "ink-3":    { "value": "#6B7484", "contrast": 4.71,  "level": "AA" },
    "ink-inv":  { "value": "#FFFFFF" },
    "divider":  { "value": "#E2E5EA", "role": "decorative separators only — NOT for control boundaries" },
    "border":   { "value": "#D4D8E0", "role": "resting edge on non-interactive cards" },
    "border-i": { "value": "#8A92A0", "contrast": 3.13, "role": "every interactive boundary. WCAG 1.4.11 requires 3:1." },
    "primary":       { "value": "#2A4FCB", "contrast": 6.82, "means": "Workbrain is asking you to act" },
    "primary-hover": { "value": "#1F3FA8" },
    "primary-tint":  { "value": "#EAEEFB" },
    "violet":        { "value": "#6A3FD1", "contrast": 6.47, "means": "this belongs to your AI — read only" },
    "violet-tint":   { "value": "#F2EDFD" },
    "violet-hover":  { "value": "#E8E0FC" },
    "amber":         { "value": "#8A5300", "contrast": 6.33, "means": "time is asking you to act — drift, staleness" },
    "amber-tint":    { "value": "#FFF4E2" },
    "amber-line":    { "value": "#E8A33D" },
    "green":         { "value": "#0B6E4F", "contrast": 6.25, "means": "done, current, healthy" },
    "green-tint":    { "value": "#E7F5EF" },
    "danger":        { "value": "#B4231E", "contrast": 6.56, "means": "something failed and you can fix it. Field errors only." },
    "danger-tint":   { "value": "#FDECEA" },
    "overlay":       { "value": "rgba(21,24,29,.42)", "role": "Sheet backdrop only — the one overlay in the system" },
    "toast-check":   { "value": "#6EE7A8", "role": "checkmark color inside a Toast, which sits on --ink" }
  },
  "font": {
    "sans": { "value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, 'Helvetica Neue', Arial, sans-serif" },
    "mono": { "value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace" }
  },
  "type": {
    "display":  { "size": "32px", "line": 1.2,  "weight": 680, "tracking": "-0.02em",  "use": "site only, never the panel" },
    "question": { "size": "22px", "line": 1.25, "weight": 660, "tracking": "-0.018em", "use": "the one question on a panel screen" },
    "section":  { "size": "17px", "line": 1.4,  "weight": 650 },
    "body":     { "size": "15px", "line": 1.6,  "weight": 400, "use": "never below 14px anywhere" },
    "support":  { "size": "13px", "line": 1.5,  "weight": 400 },
    "label":    { "size": "12px", "line": 1.4,  "weight": 650, "tracking": "0.08em", "transform": "uppercase", "use": "2–3 words max" }
  },
  "space": { "scale": [4, 8, 12, 16, 20, 24, 32, 48, 64], "base": 4 },
  "radius": { "sm": "6px", "md": "10px", "lg": "14px", "pill": "999px" },
  "elevation": {
    "1": { "value": "0 1px 2px rgba(21,24,29,.06)",  "use": "hover lift on an interactive row" },
    "2": { "value": "0 4px 12px rgba(21,24,29,.08), 0 1px 3px rgba(21,24,29,.06)", "use": "the panel against the page" },
    "3": { "value": "0 16px 40px rgba(21,24,29,.14), 0 2px 8px rgba(21,24,29,.08)", "use": "sheets and toasts only" }
  },
  "motion": {
    "fast": "120ms", "base": "200ms", "slow": "320ms",
    "ease": "cubic-bezier(.2,0,0,1)",
    "$comment": "One easing curve for everything. Three durations. No others."
  },
  "target": { "min": "44px", "$comment": "every control, including icon buttons" },
  "focus":  { "ring": "2px solid var(--primary)", "offset": "2px" }
}
