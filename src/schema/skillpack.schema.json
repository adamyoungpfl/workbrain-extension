{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelcitizen.ai/schema/workbrain-skillpack-1.json",
  "title": "Workbrain skill pack",
  "description": "A versioned set of skills a company publishes at an HTTPS URL. Fetched by the panel, treated as untrusted data, never executed.",
  "type": "object",
  "required": ["packVersion", "id", "name", "revision", "updated", "skills"],
  "additionalProperties": false,
  "properties": {
    "packVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "name": { "type": "string", "maxLength": 80 },
    "summary": { "type": "string", "maxLength": 280 },
    "publisher": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "contact": { "type": "string", "maxLength": 120 }
      }
    },
    "revision": { "type": "integer", "minimum": 1,
      "description": "Increment on every publish. The panel compares this to decide whether to offer an update." },
    "updated": { "type": "string", "format": "date" },
    "skills": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": ["id", "title", "body"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "title": { "type": "string", "maxLength": 80 },
        "summary": { "type": "string", "maxLength": 280 },
        "step": { "type": "integer", "minimum": 1, "maximum": 4,
          "description": "Which of Name/Repeat/Act/Share this belongs to. Internally a gate; never shown as that word." },
        "slots": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/slot" } },
        "body": { "type": "string", "maxLength": 20000,
          "description": "Markdown with {{slot}} placeholders. Rendered as TEXT. Any HTML is escaped, never parsed." }
      }
    },
    "slot": {
      "type": "object",
      "required": ["key"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}$" },
        "label": { "type": "string", "maxLength": 80,
          "description": "Shown if we have to ask the person directly." },
        "from": { "type": "string", "maxLength": 120,
          "description": "Dotted path into the person's own answers, resolved locally. e.g. 'roles[0]', 'audience.primary'." },
        "fallback": { "type": "string", "maxLength": 400 }
      }
    }
  }
}
